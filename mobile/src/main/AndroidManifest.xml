<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_carplay"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@drawable/ic_carplay"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.Xcertplay">

        <meta-data
            android:name="android.allow_multiple_resumed_activities"
            android:value="true" />

        <!-- Based on the split-screen metadata declared by DiLink system apps. -->
        <meta-data
            android:name="BYD_SUPPORT_SPLIT_ACTIVITY"
            android:value="1" />

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            tools:replace="android:enabled" />

        <receiver
            android:name="com.shilapi.xcertplay.PhoneBluetoothReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <service android:name="com.shilapi.xcertplay.shared.MyCarAppService" tools:node="remove" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" tools:node="remove" />

        <!-- Geely/OneOS compatibility build only. This vehicle's OnlineMusicService addresses
             these two component names inside io.dushu.car: a broadcast receiver for media keys and
             a trampoline activity for the card's play button. Both stay disabled in the ordinary
             com.shihab.diplay install so no extra entry point is exposed there. -->
        <receiver
            android:name="io.dushu.car.receiver.MediaControlReceiver"
            android:enabled="${geelyOemCompatEnabled}"
            android:exported="true" />

        <activity
            android:name="io.dushu.car.mvp.view.TransparentActivity"
            android:enabled="${geelyOemCompatEnabled}"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="io.dushu.car.factory"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
